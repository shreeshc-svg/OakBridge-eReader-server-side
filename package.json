          "@types/node-cron": "^3.0.11",
          "@types/nodemailer": "^8.0.1",
          "bcryptjs": "^3.0.3",
          "compression": "^1.8.1",
          "cookie-parser": "^1.4.7",
          "cors": "^2.8.6",
